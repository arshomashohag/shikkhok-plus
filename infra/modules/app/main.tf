# The application host.
#
# **One Lightsail instance running the backend and its database in
# containers.** At 100 teachers on a 2 GB instance, an ALB would
# consume a third of the budget before any compute [D-29], and
# blue-green deployment is machinery for a scale this does not have.
#
# **Origin lock-down is a SHARED SECRET, not a CIDR allowlist, and the
# reason is a hard Lightsail limit rather than a preference.**
# CloudFront publishes 214 origin-facing CIDR ranges; a Lightsail
# firewall rule accepts at most 5. The CIDR approach cannot be
# expressed here at all -- it would fail at apply time, not at review.
#
# So CloudFront injects a secret header and nginx on the origin refuses
# any request without it. Port 443 is open to the internet, but a
# direct request is rejected by our own host before it reaches the
# application. The secret is generated by Terraform, never written to
# the repository, and rotating it is a `terraform taint` away.

terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.70"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
}

# The shared secret. 32 bytes of randomness, held in state and never in
# a file: state is already sensitive and already gitignored, whereas a
# committed value would be a credential in the repository.
resource "random_password" "origin_secret" {
  length  = 48
  special = false
}

resource "aws_lightsail_instance" "app" {
  name              = "${var.name_prefix}-app"
  availability_zone = var.availability_zone
  blueprint_id      = "ubuntu_22_04"
  bundle_id         = var.bundle_id
  key_pair_name     = var.ssh_key_pair_name

  # Installs Docker and nginx and writes the origin-secret check. The
  # application itself is deployed separately -- user_data runs once at
  # first boot, so using it to deploy would mean a redeploy requires a
  # new instance.
  user_data = templatefile("${path.module}/user_data.sh.tftpl", {
    origin_secret = random_password.origin_secret.result
  })

  tags = {
    Role = "app"
  }
}

# A static IP. **Free while attached**, and the reason is not
# convenience: the SMS gateway may require an allowlisted source
# address, and an IP that changes on restart cannot be allowlisted. It
# is also CloudFront's origin, so losing it would mean a DNS change
# under pressure.
resource "aws_lightsail_static_ip" "app" {
  name = "${var.name_prefix}-app-ip"
}

resource "aws_lightsail_static_ip_attachment" "app" {
  static_ip_name = aws_lightsail_static_ip.app.name
  instance_name  = aws_lightsail_instance.app.name
}

resource "aws_lightsail_instance_public_ports" "app" {
  instance_name = aws_lightsail_instance.app.name

  # HTTPS. Open to the internet because CloudFront's 214 origin CIDRs
  # do not fit in a Lightsail rule -- the shared-secret header in
  # user_data is what actually enforces "through the CDN only", and it
  # does so at the origin rather than at the firewall.
  port_info {
    protocol  = "tcp"
    from_port = 443
    to_port   = 443
    cidrs     = ["0.0.0.0/0"]
  }

  # HTTP, redirected to HTTPS by nginx. Present so a port-80 request
  # gets an answer instead of hanging: a timeout looks like an outage
  # to whoever hit it.
  port_info {
    protocol  = "tcp"
    from_port = 80
    to_port   = 80
    cidrs     = ["0.0.0.0/0"]
  }

  # SSH from the operator ONLY. The root variable refuses 0.0.0.0/0
  # outright, because an open SSH port on a host holding children's
  # data is the cheapest possible mistake to make here.
  port_info {
    protocol  = "tcp"
    from_port = 22
    to_port   = 22
    cidrs     = [var.operator_ip_cidr]
  }

  # **PostgreSQL's 5432 is deliberately ABSENT.** The database runs in
  # a container bound to 127.0.0.1, reachable only from the application
  # on the same host. There is no rule to get wrong because there is no
  # port open -- which is why Phase 1 keeps the database here rather
  # than on a publicly addressable RDS endpoint.
}
