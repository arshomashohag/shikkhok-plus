#!/bin/bash
# First-boot provisioning. Runs ONCE, so it installs the machine and
# never deploys the application -- a deploy that required a new
# instance would make every release a migration.
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive
apt-get update
# certbot is ABSENT: CloudFront terminates public TLS with an ACM
# certificate, so the origin needs only a self-signed one for the
# CloudFront-to-origin hop. A Let's Encrypt renewal nobody checks is a
# certificate that expires on a Sunday.
# **ssl-cert is NOT optional.** It is what generates
# /etc/ssl/certs/ssl-cert-snakeoil.pem, which the TLS server block
# below references. Without it nginx fails its config test with
# `cannot load certificate ... No such file or directory`, falls back
# to its packaged default, and serves port 80 only -- while the
# instance still reports a successful boot. CloudFront is configured
# https-only, so every request through the CDN then 502s.
apt-get install -y --no-install-recommends \
  docker.io docker-compose-v2 nginx ssl-cert

usermod -aG docker ubuntu
systemctl enable --now docker

# The SSM agent, which is what replaces SSH. Ubuntu 24.04 ships it as
# a snap and it is pre-installed on Canonical's AMIs -- enabling it
# explicitly is cheap and makes a missing agent a boot-time failure
# rather than a mystery when the first session is attempted.
snap install amazon-ssm-agent --classic 2>/dev/null || true
snap start amazon-ssm-agent 2>/dev/null || systemctl enable --now snap.amazon-ssm-agent.amazon-ssm-agent.service

# The origin secret. Readable only by root, because any process that
# can read it can forge a request that looks like it came through the
# CDN.
install -m 600 /dev/null /etc/nginx/origin_secret.conf
cat > /etc/nginx/origin_secret.conf <<'NGINX'
# CloudFront sets this header on every origin request. A request
# arriving without it did not come through the CDN -- so it bypassed
# TLS policy enforcement, Shield Standard, and any WAF added later.
#
# 403 rather than 404: there is no information to protect here. The
# host's existence is public (it has a static IP), and a 404 would
# imply the path is wrong rather than the route.
if ($http_x_origin_secret != "${origin_secret}") {
    return 403;
}
NGINX

cat > /etc/nginx/sites-available/shikkhokplus <<'NGINX'
server {
    listen 80 default_server;
    server_name _;
    # Answer rather than hang. A timeout reads as an outage.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl default_server;
    server_name _;

    # A self-signed certificate is sufficient and correct here.
    # CloudFront terminates the PUBLIC TLS session with an ACM
    # certificate; this one secures only the CloudFront-to-origin hop,
    # and CloudFront does not validate an origin certificate's chain
    # when the origin protocol policy is https-only.
    ssl_certificate     /etc/ssl/certs/ssl-cert-snakeoil.pem;
    ssl_certificate_key /etc/ssl/private/ssl-cert-snakeoil.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    include /etc/nginx/origin_secret.conf;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host              $host;
        # The REAL client IP, not CloudFront's. The OTP rate limiter
        # counts per IP, so without this every request would look like
        # one caller and a per-IP limit would become a global one.
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }
}
NGINX

ln -sf /etc/nginx/sites-available/shikkhokplus /etc/nginx/sites-enabled/default

# **Generated explicitly rather than trusted to the package.** The
# ssl-cert package normally creates the snakeoil pair on install, but
# that depends on its postinst running to completion -- and if it does
# not, the failure is the silent one above. make-ssl-cert is
# idempotent, so running it costs nothing when the file already
# exists and saves the boot when it does not.
make-ssl-cert generate-default-snakeoil --force-overwrite

# **`nginx -t || exit 1`, not `nginx -t && reload`.** With `&&` a
# failed test skipped the reload and the script still exited 0, so
# the instance reported a successful provision while serving nothing
# on 443. That is exactly how this bug reached a running host.
if ! nginx -t; then
  echo "FAILED: nginx config test" > /var/log/shikkhokplus-provision.log
  exit 1
fi

systemctl restart nginx

# Assert the outcome, not the command. A successful reload does not
# prove a listener exists -- nginx can reload into a config that
# binds nothing. This is the check that would have caught it.
sleep 2
if ! ss -tln | grep -q ':443 '; then
  echo "FAILED: nothing listening on 443" > /var/log/shikkhokplus-provision.log
  exit 1
fi

# ---------------------------------------------------------------------
# The application's home on this host
# ---------------------------------------------------------------------
#
# Created at boot so the deploy step has somewhere to write. A deploy
# that has to mkdir its own directory is a deploy that runs as root
# for no reason.
install -d -o ubuntu -g ubuntu -m 0750 /srv/shikkhokplus

# The AWS CLI, for `ecr get-login-password`. Ubuntu's apt version is
# v1 and too old for some ECR flows, so the official v2 bundle is
# installed instead -- arm64, matching the host.
# **PATH is set explicitly.** cloud-init runs this as root with a
# minimal environment, and the CLI v2 installer puts `aws` in
# /usr/local/bin -- which is not reliably on root's PATH here. Without
# this the install succeeds and the next `aws` call fails with
# "command not found", which under `set -e` aborts the boot at a step
# that looks unrelated.
export PATH="/usr/local/bin:/usr/bin:/bin:$PATH"

if ! command -v aws >/dev/null 2>&1; then
  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-aarch64.zip" \
    -o /tmp/awscliv2.zip
  apt-get install -y --no-install-recommends unzip
  unzip -q /tmp/awscliv2.zip -d /tmp
  /tmp/aws/install
  rm -rf /tmp/aws /tmp/awscliv2.zip
fi

# **Asserted, because every step after this needs it.** An install
# that half-succeeded leaves a boot that fails three steps later with
# a message about DNS or SSM rather than about the CLI.
if ! aws --version >/dev/null 2>&1; then
  {
    echo "FAILED: the AWS CLI is not usable after install"
    echo "  which aws: $(command -v aws || echo 'not found')"
    echo "  PATH: $PATH"
  } > /var/log/shikkhokplus-provision.log
  exit 1
fi

# **A credential helper rather than a stored login.** `docker login`
# writes a token to ~/.docker/config.json that expires in 12 hours,
# so a host that reboots after that cannot pull and the failure looks
# like a registry outage. The helper fetches a fresh token per pull,
# using the instance profile -- nothing is stored and nothing expires.
cat > /usr/local/bin/docker-credential-ecr-login <<'HELPER'
#!/bin/bash
# Minimal ECR credential helper. Docker calls this with "get" on
# stdin carrying the registry host.
set -euo pipefail
[ "$1" = "get" ] || exit 0
host=$(cat)
region=$(echo "$host" | sed -n 's/.*\.dkr\.ecr\.\([a-z0-9-]*\)\.amazonaws\.com.*/\1/p')
[ -n "$region" ] || exit 1
token=$(aws ecr get-login-password --region "$region")
printf '{"ServerURL":"%s","Username":"AWS","Secret":"%s"}' "$host" "$token"
HELPER
chmod 0755 /usr/local/bin/docker-credential-ecr-login

install -d -o ubuntu -g ubuntu -m 0700 /home/ubuntu/.docker
cat > /home/ubuntu/.docker/config.json <<DOCKERCFG
{
  "credHelpers": {
    "${ecr_registry}": "ecr-login"
  }
}
DOCKERCFG
chown ubuntu:ubuntu /home/ubuntu/.docker/config.json

# Recorded for the deploy step, so it does not have to reconstruct
# the registry hostname from an account id and a region.
echo "${ecr_repository_url}" > /srv/shikkhokplus/image-repository
chown ubuntu:ubuntu /srv/shikkhokplus/image-repository

# ---------------------------------------------------------------------
# Self-registration: this instance announces its own address
# ---------------------------------------------------------------------
#
# **Replaces the Elastic IP.** An ASG instance gets a new public IP on
# every replacement, so a Terraform-managed A record would be stale the
# moment the box is replaced -- and re-attaching an EIP needs a
# lifecycle hook that can fail halfway, leaving an instance running and
# unreachable.
#
# Writing the record from the instance inverts that: whatever comes up
# is what CloudFront reaches, within one TTL, with nothing to
# re-attach. Terraform deliberately does NOT own this record.

TOKEN=$(curl -fsS -X PUT "http://169.254.169.254/latest/api/token" \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
PUBLIC_IP=$(curl -fsS -H "X-aws-ec2-metadata-token: $TOKEN" \
  http://169.254.169.254/latest/meta-data/public-ipv4)

if [ -z "$PUBLIC_IP" ]; then
  echo "FAILED: no public IPv4 from IMDS" > /var/log/shikkhokplus-provision.log
  exit 1
fi

cat > /tmp/dns-register.json <<DNSJSON
{
  "Comment": "Self-registration at boot",
  "Changes": [{
    "Action": "UPSERT",
    "ResourceRecordSet": {
      "Name": "${origin_fqdn}",
      "Type": "A",
      "TTL": 60,
      "ResourceRecords": [{"Value": "$PUBLIC_IP"}]
    }
  }]
}
DNSJSON

# **The error is captured, not discarded.** An earlier version piped
# stdout to /dev/null and wrote only "FAILED: DNS self-registration",
# which threw away the one thing needed to diagnose it -- AWS reports
# the reason on stderr, and the handler lost that too. The boot log
# then said a step failed and nothing about why.
if ! dns_error=$(aws route53 change-resource-record-sets \
    --hosted-zone-id "${dns_zone_id}" \
    --change-batch file:///tmp/dns-register.json \
    --region us-east-1 2>&1); then
  {
    echo "FAILED: DNS self-registration"
    echo "  zone:  ${dns_zone_id}"
    echo "  name:  ${origin_fqdn}"
    echo "  value: $PUBLIC_IP"
    echo "  aws cli: $(command -v aws || echo 'NOT INSTALLED')"
    echo "  error:"
    echo "$dns_error" | sed 's/^/    /'
  } > /var/log/shikkhokplus-provision.log
  exit 1
fi
rm -f /tmp/dns-register.json
echo "Registered ${origin_fqdn} -> $PUBLIC_IP"

# ---------------------------------------------------------------------
# Self-healing: bring the application up without waiting for a deploy
# ---------------------------------------------------------------------
#
# **This is what makes a replaced instance useful.** Without it the box
# boots healthy, nginx answers, and the API is simply absent until
# somebody notices and dispatches a deploy.
#
# The tag comes from SSM rather than from Terraform, because Terraform
# must not own which version runs -- an apply would otherwise change
# the deployed application.

IMAGE_TAG=$(aws ssm get-parameter \
  --name "/shikkhokplus/${name_prefix}/image-tag" \
  --query 'Parameter.Value' --output text \
  --region "${aws_region}" 2>/dev/null || echo "none")

if [ "$IMAGE_TAG" = "none" ] || [ -z "${ecr_repository_url}" ]; then
  # A first-ever boot, before any deploy has run. Correct and
  # expected: nginx serves, the API is absent, and the next deploy
  # fills it in. NOT an error.
  echo "provisioned (no image deployed yet)" \
    > /var/log/shikkhokplus-provision.log
  exit 0
fi

# **The compose file comes from git, the secrets from SSM.** Neither
# survives instance replacement on the root volume, so a self-healing
# boot reconstructs both rather than waiting for a human to notice the
# API is missing.
cd /srv/shikkhokplus

RUNTIME_ENV=$(aws ssm get-parameter \
  --name "/shikkhokplus/${name_prefix}/runtime-env" \
  --with-decryption --query 'Parameter.Value' --output text \
  --region "${aws_region}" 2>/dev/null || echo "")

if [ -z "$RUNTIME_ENV" ] || [ "$RUNTIME_ENV" = "SHIKKHOKPLUS_ENVIRONMENT=unset" ]; then
  echo "provisioned (image $IMAGE_TAG known, no runtime env yet)" \
    > /var/log/shikkhokplus-provision.log
  exit 0
fi

umask 077
printf '%s\n' "$RUNTIME_ENV" > .env
echo "API_IMAGE=${ecr_repository_url}:$IMAGE_TAG" >> .env
echo "SHIKKHOKPLUS_DATABASE_URL=${database_url}" >> .env
chown ubuntu:ubuntu .env

cat > docker-compose.yml <<'COMPOSEEOF'
${compose_file}
COMPOSEEOF
chown ubuntu:ubuntu docker-compose.yml

sudo -u ubuntu docker compose pull

# **Migrations as a distinct, logged step, before anything serves.**
#
# team.md: "Alembic runs as a distinct, logged step before the new
# container serves traffic, never as a side effect of application
# start." A container that migrates on start migrates once per
# replica and gives the operator no place to stop between the backup
# and the schema change.
#
# `run --rm` rather than `exec`: there is no running container yet,
# and this must complete before one exists.
echo "Running migrations..." >> /var/log/shikkhokplus-provision.log
if ! sudo -u ubuntu docker compose run --rm api alembic upgrade head \
     >> /var/log/shikkhokplus-provision.log 2>&1; then
  echo "FAILED: alembic upgrade head" >> /var/log/shikkhokplus-provision.log
  # **Exit non-zero and serve nothing.** An instance that starts the
  # API against a schema the migration could not apply is worse than
  # an instance that does not start: it answers requests wrongly.
  exit 1
fi

sudo -u ubuntu docker compose up -d --remove-orphans

# **Assert the outcome, not the command.** `up -d` succeeds on a
# container that starts and immediately exits, so a boot reporting
# success here would hide exactly the failure this script exists to
# catch.
for _ in $(seq 1 12); do
  if curl -fsS -m 5 http://127.0.0.1:8000/health >/dev/null 2>&1; then
    echo "provisioned (running $IMAGE_TAG, migrated, healthy)" \
      >> /var/log/shikkhokplus-provision.log
    exit 0
  fi
  sleep 5
done

echo "FAILED: $IMAGE_TAG started but /health did not answer in 60s" \
  >> /var/log/shikkhokplus-provision.log
sudo -u ubuntu docker compose logs --tail 50 \
  >> /var/log/shikkhokplus-provision.log 2>&1
exit 1
