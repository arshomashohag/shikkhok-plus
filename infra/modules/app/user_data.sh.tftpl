#!/bin/bash
# First-boot provisioning. Runs ONCE, so it installs the machine and
# never deploys the application -- a deploy that required a new
# instance would make every release a migration.
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive
apt-get update
# **certbot is REQUIRED, and the comment that used to stand here was
# wrong in a way that cost three days of a dead staging origin.**
#
# It read: "certbot is ABSENT: CloudFront terminates public TLS with an
# ACM certificate, so the origin needs only a self-signed one for the
# CloudFront-to-origin hop. A Let's Encrypt renewal nobody checks is a
# certificate that expires on a Sunday."
#
# The second sentence is a fair concern and the first is false.
# CloudFront DOES validate a custom origin's certificate. AWS documents
# that it does not support self-signed origin certificates, and that
# when no name in the certificate matches the origin domain it drops
# the connection and returns 502. Proven on this host 2026-10-24: with
# verification on, the handshake fails `no alternative certificate
# subject name matches target host name`; with it off, nginx answers
# normally. The application was healthy the whole time and the nginx
# access log was zero bytes, because no request ever arrived.
#
# So the origin needs a REAL certificate. DNS-01 is used rather than
# HTTP-01 because the security group admits only 443 from CloudFront's
# prefix list, so there is no port 80 for a challenge to land on. The
# instance role carries the three Route53 permissions this needs,
# including ListHostedZones, which the plugin uses to find the zone by
# name before writing the _acme-challenge record.
#
# The renewal concern is answered rather than dismissed: certbot
# installs its own systemd timer, and a deploy hook reloads nginx and
# persists the renewed lineage to the config bucket. A boot RESTORES
# that lineage rather than issuing again -- re-issuing on every deploy
# hit Let's Encrypt's 5-duplicates-a-week limit [OPS-8].
#
# **ssl-cert is still NOT optional.** It generates the snakeoil pair
# that the TLS server block falls back to on first boot, before certbot
# has run. Without it nginx fails its config test with `cannot load
# certificate ... No such file or directory`, falls back to its
# packaged default, and serves port 80 only -- while the instance still
# reports a successful boot.
apt-get install -y --no-install-recommends \
  docker.io docker-compose-v2 nginx ssl-cert \
  certbot python3-certbot-dns-route53

usermod -aG docker ubuntu
systemctl enable --now docker

# The SSM agent, which is what replaces SSH. Ubuntu 24.04 ships it as
# a snap and it is pre-installed on Canonical's AMIs -- enabling it
# explicitly is cheap and makes a missing agent a boot-time failure
# rather than a mystery when the first session is attempted.
snap install amazon-ssm-agent --classic 2>/dev/null || true
snap start amazon-ssm-agent 2>/dev/null || systemctl enable --now snap.amazon-ssm-agent.amazon-ssm-agent.service

# The AWS CLI, for `ecr get-login-password` and -- since the secrets
# left user_data [OPS-4] -- for reading them from SSM before nginx is
# configured. It is therefore installed FIRST. Ubuntu's apt version is
# v1 and too old for some ECR flows, so the official v2 bundle is
# installed instead -- arm64, matching the host.
# **PATH is set explicitly.** cloud-init runs this as root with a
# minimal environment, and the CLI v2 installer puts `aws` in
# /usr/local/bin -- which is not reliably on root's PATH here. Without
# this the install succeeds and the next `aws` call fails with
# "command not found", which under `set -e` aborts the boot at a step
# that looks unrelated.
export PATH="/usr/local/bin:/usr/bin:/bin:$PATH"

if ! command -v aws >/dev/null 2>&1; then
  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-aarch64.zip" \
    -o /tmp/awscliv2.zip
  apt-get install -y --no-install-recommends unzip
  unzip -q /tmp/awscliv2.zip -d /tmp
  /tmp/aws/install
  rm -rf /tmp/aws /tmp/awscliv2.zip
fi

# **Asserted, because every step after this needs it.** An install
# that half-succeeded leaves a boot that fails three steps later with
# a message about DNS or SSM rather than about the CLI.
if ! aws --version >/dev/null 2>&1; then
  {
    echo "FAILED: the AWS CLI is not usable after install"
    echo "  which aws: $(command -v aws || echo 'not found')"
    echo "  PATH: $PATH"
  } > /var/log/shikkhokplus-provision.log
  exit 1
fi

# One reader for every parameter, so the path shape and the region are
# written once. SecureStrings are decrypted by SSM with the instance
# role, which may read exactly the parameters secrets.tf lists.
param() {
  aws ssm get-parameter --name "/shikkhokplus/${name_prefix}/$1" \
    --with-decryption --query 'Parameter.Value' --output text \
    --region "${aws_region}"
}

# The origin secret. Readable only by root, because any process that
# can read it can forge a request that looks like it came through the
# CDN.
#
# CloudFront sets this header on every origin request. A request
# arriving without it did not come through the CDN -- so it bypassed
# TLS policy enforcement, Shield Standard, and any WAF added later.
# 403 rather than 404: there is no information to protect here.
#
# **Read from SSM, never from the template** [OPS-4]. It is checked to
# be the alphanumeric string Terraform generates before it is written
# into an nginx config, so a malformed value fails the boot here rather
# than producing a config that matches nothing -- or anything.
ORIGIN_SECRET=$(param origin-secret)
if ! [[ "$ORIGIN_SECRET" =~ ^[A-Za-z0-9]{32,}$ ]]; then
  echo "FAILED: origin secret missing or malformed in SSM" > /var/log/shikkhokplus-provision.log
  exit 1
fi
install -m 600 /dev/null /etc/nginx/origin_secret.conf
printf 'if ($http_x_origin_secret != "%s") {\n    return 403;\n}\n' \
  "$ORIGIN_SECRET" > /etc/nginx/origin_secret.conf
# Kept in this (unexported) shell variable for the readiness probe at
# the end, which must present it exactly as CloudFront does.

cat > /etc/nginx/sites-available/shikkhokplus <<'NGINX'
# The viewer's address as CloudFront saw it, without the port.
# CloudFront-Viewer-Address is `ip:port`; IPv6 addresses carry no
# brackets, so the port is whatever follows the LAST colon and the
# greedy capture takes everything before it. The capture admits only
# hex digits, colons and dots, so the result is one bare address --
# never a list, a bracket or anything a caller smuggled in. Absent or
# malformed yields "", and nginx then sends no X-Client-Address at all.
map $http_cloudfront_viewer_address $shikkhok_client_ip {
    "~^(?<addr>[0-9A-Fa-f:.]+):[0-9]+$" $addr;
    default "";
}

server {
    listen 80 default_server;
    server_name _;
    # Answer rather than hang. A timeout reads as an outage.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl default_server;
    server_name _;

    # **The snakeoil pair is the FALLBACK, not the answer.** It is what
    # nginx starts on before certbot has run, so the host is reachable
    # over SSM and the boot can continue. The certbot step later in
    # this script replaces both paths with a real Let's Encrypt
    # certificate and reloads.
    #
    # It is NOT sufficient on its own: CloudFront validates a custom
    # origin's certificate, does not support self-signed ones, and
    # returns 502 when no name matches the origin domain. An earlier
    # version of this comment claimed the opposite and the staging
    # origin 502'd for three days with a healthy application behind it.
    ssl_certificate     /etc/ssl/certs/ssl-cert-snakeoil.pem;
    ssl_certificate_key /etc/ssl/private/ssl-cert-snakeoil.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    include /etc/nginx/origin_secret.conf;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host              $host;
        # **The REAL client IP, and only from CloudFront.** The OTP rate
        # limiter counts per IP. X-Forwarded-For was appended to rather
        # than replaced, so a caller could put any address first and
        # choose which bucket they counted against. X-Client-Address is
        # ALWAYS set here -- proxy_set_header replaces a client-sent
        # header of the same name, and an empty value sends none -- so
        # the application, told by SHIKKHOKPLUS_TRUSTED_CLIENT_IP_HEADER
        # to read it, sees only what CloudFront observed.
        proxy_set_header X-Client-Address  $shikkhok_client_ip;
        proxy_set_header X-Forwarded-For   "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }
}
NGINX

ln -sf /etc/nginx/sites-available/shikkhokplus /etc/nginx/sites-enabled/default

# **Generated explicitly rather than trusted to the package.** The
# ssl-cert package normally creates the snakeoil pair on install, but
# that depends on its postinst running to completion -- and if it does
# not, the failure is the silent one above. make-ssl-cert is
# idempotent, so running it costs nothing when the file already
# exists and saves the boot when it does not.
make-ssl-cert generate-default-snakeoil --force-overwrite

# **`nginx -t || exit 1`, not `nginx -t && reload`.** With `&&` a
# failed test skipped the reload and the script still exited 0, so
# the instance reported a successful provision while serving nothing
# on 443. That is exactly how this bug reached a running host.
if ! nginx -t; then
  echo "FAILED: nginx config test" > /var/log/shikkhokplus-provision.log
  exit 1
fi

systemctl restart nginx

# Assert the outcome, not the command. A successful reload does not
# prove a listener exists -- nginx can reload into a config that
# binds nothing. This is the check that would have caught it.
sleep 2
if ! ss -tln | grep -q ':443 '; then
  echo "FAILED: nothing listening on 443" > /var/log/shikkhokplus-provision.log
  exit 1
fi

# ---------------------------------------------------------------------
# The application's home on this host
# ---------------------------------------------------------------------
#
# Created at boot so the deploy step has somewhere to write. A deploy
# that has to mkdir its own directory is a deploy that runs as root
# for no reason.
install -d -o ubuntu -g ubuntu -m 0750 /srv/shikkhokplus

# **A credential helper rather than a stored login.** `docker login`
# writes a token to ~/.docker/config.json that expires in 12 hours,
# so a host that reboots after that cannot pull and the failure looks
# like a registry outage. The helper fetches a fresh token per pull,
# using the instance profile -- nothing is stored and nothing expires.
cat > /usr/local/bin/docker-credential-ecr-login <<'HELPER'
#!/bin/bash
# Minimal ECR credential helper. Docker calls this with "get" on
# stdin carrying the registry host.
set -euo pipefail
[ "$1" = "get" ] || exit 0
host=$(cat)
region=$(echo "$host" | sed -n 's/.*\.dkr\.ecr\.\([a-z0-9-]*\)\.amazonaws\.com.*/\1/p')
[ -n "$region" ] || exit 1
token=$(aws ecr get-login-password --region "$region")
printf '{"ServerURL":"%s","Username":"AWS","Secret":"%s"}' "$host" "$token"
HELPER
chmod 0755 /usr/local/bin/docker-credential-ecr-login

install -d -o ubuntu -g ubuntu -m 0700 /home/ubuntu/.docker
cat > /home/ubuntu/.docker/config.json <<DOCKERCFG
{
  "credHelpers": {
    "${ecr_registry}": "ecr-login"
  }
}
DOCKERCFG
chown ubuntu:ubuntu /home/ubuntu/.docker/config.json

# Recorded for the deploy step, so it does not have to reconstruct
# the registry hostname from an account id and a region.
echo "${ecr_repository_url}" > /srv/shikkhokplus/image-repository
chown ubuntu:ubuntu /srv/shikkhokplus/image-repository

# ---------------------------------------------------------------------
# Self-registration and readiness: defined here, CALLED at the end
# ---------------------------------------------------------------------
#
# **Replaces the Elastic IP.** An ASG instance gets a new public IP on
# every replacement, so a Terraform-managed A record would be stale the
# moment the box is replaced. Writing the record from the instance
# inverts that: whatever comes up is what CloudFront reaches, within
# one TTL. Terraform deliberately does NOT own this record.
#
# **Registered only once this host is READY, not at the top of the
# boot** [OPS-6]. A deploy now launches the new host BEFORE terminating
# the old one. Registering first would point CloudFront at a box still
# installing packages and migrating -- 502s for minutes while a healthy
# host sat beside it. Registering last means the old host serves until
# the new one has proved itself, and the refresh's instance warmup
# (longer than the record's 60 s TTL) gives CloudFront time to follow
# before the old host is terminated.

imds() {
  local token
  token=$(curl -fsS -X PUT "http://169.254.169.254/latest/api/token" \
    -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
  curl -fsS -H "X-aws-ec2-metadata-token: $token" \
    "http://169.254.169.254/latest/meta-data/$1"
}

register_dns() {
  local public_ip dns_error
  public_ip=$(imds public-ipv4) || public_ip=""
  if [ -z "$public_ip" ]; then
    echo "FAILED: no public IPv4 from IMDS" >> /var/log/shikkhokplus-provision.log
    return 1
  fi
  cat > /tmp/dns-register.json <<DNSJSON
{"Comment": "Self-registration at boot", "Changes": [{"Action": "UPSERT",
 "ResourceRecordSet": {"Name": "${origin_fqdn}", "Type": "A", "TTL": 60,
 "ResourceRecords": [{"Value": "$public_ip"}]}}]}
DNSJSON
  # **The error is captured, not discarded.** AWS reports the reason on
  # stderr; an earlier version threw it away and the boot log said a
  # step failed and nothing about why.
  if ! dns_error=$(aws route53 change-resource-record-sets \
      --hosted-zone-id "${dns_zone_id}" \
      --change-batch file:///tmp/dns-register.json \
      --region us-east-1 2>&1); then
    {
      echo "FAILED: DNS self-registration of ${origin_fqdn} -> $public_ip"
      echo "$dns_error" | sed 's/^/    /'
    } >> /var/log/shikkhokplus-provision.log
    return 1
  fi
  rm -f /tmp/dns-register.json
  echo "Registered ${origin_fqdn} -> $public_ip" >> /var/log/shikkhokplus-provision.log
}

# **The readiness signal** [OPS-6]. The group's launch lifecycle hook
# holds every new instance in Pending:Wait until this says CONTINUE; no
# answer within the hook's timeout, or ABANDON, and the ASG terminates
# the instance instead of putting it in service. During a deploy that
# means a host which cannot serve never replaces one which can.
#
# The group's name comes from the instance's own tags through IMDS
# (instance_metadata_tags is enabled), because the launch template
# cannot name the group that uses it. "No lifecycle action" is not an
# error: a brand-new group launches its first instance before the
# hook exists, and that instance has nothing to answer.
lifecycle() {
  local asg iid
  asg=$(imds tags/instance/aws:autoscaling:groupName) || return 0
  iid=$(imds instance-id) || return 0
  aws autoscaling complete-lifecycle-action \
    --lifecycle-hook-name "${lifecycle_hook_name}" \
    --auto-scaling-group-name "$asg" --instance-id "$iid" \
    --lifecycle-action-result "$1" --region "${aws_region}" \
    >> /var/log/shikkhokplus-provision.log 2>&1 \
    || echo "lifecycle $1: no pending action for $iid" \
         >> /var/log/shikkhokplus-provision.log
}

# A boot that fails anywhere from here on says so at once, rather than
# leaving the ASG to wait out the hook's full timeout.
trap 'rc=$?; [ "$rc" -eq 0 ] || lifecycle ABANDON' EXIT

# A host with nothing to run yet -- first boot before any deploy --
# is still a correct host: register it and put it in service.
ready_without_app() {
  register_dns
  lifecycle CONTINUE
  exit 0
}

# ---------------------------------------------------------------------
# A real origin certificate, so CloudFront will talk to us at all
# ---------------------------------------------------------------------
#
# **Restored, not re-issued** [OPS-8]. Every boot used to request a new
# Let's Encrypt certificate, and every deploy is a boot. Let's Encrypt
# allows 5 duplicate certificates per 7 days, so the sixth deploy in a
# week got a refusal, fell back to snakeoil, and CloudFront returned
# 502 to every request while the boot reported success. Renewal, when it
# did happen, never reloaded nginx, so a renewed certificate sat on disk
# while nginx served the old one until it expired.
#
# Now /etc/letsencrypt -- account, renewal config and the lineage --
# lives in the config bucket (SSE, TLS-only, private). A boot restores
# it and uses the certificate when it has more than 30 days left; only
# otherwise does certbot run, and `--keep-until-expiring` makes that a
# renewal of the restored lineage rather than a fresh issuance. Two
# hosts overlapping during a launch-before-terminate refresh therefore
# both restore the same certificate and neither touches Let's Encrypt.
#
# The deploy hook runs after EVERY successful issuance or renewal --
# certbot records it in the lineage's renewal config, so the systemd
# timer's renewals run it too. It points nginx at the live files,
# reloads, and uploads the new state.
#
# DNS-01 writes only a TXT record, so it does not depend on this
# host's A record existing yet -- which matters now that the A record
# is written only once the host is ready.
#
# **Failure here is not fatal to the boot by itself.** nginx keeps the
# snakeoil pair and the boot continues -- but the readiness check at
# the end calls the origin over TLS WITH certificate verification, as
# CloudFront does, so a host serving snakeoil never reports ready and is
# never put in service.
cat > /usr/local/bin/shikkhokplus-cert-deployed <<'HOOK'
#!/bin/bash
set -euo pipefail
export PATH="/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
LIVE="/etc/letsencrypt/live/${origin_fqdn}"
SITE=/etc/nginx/sites-available/shikkhokplus
cp "$SITE" "$SITE.bak"
sed -i \
  -e "s#^\( *ssl_certificate \).*#\1$LIVE/fullchain.pem;#" \
  -e "s#^\( *ssl_certificate_key \).*#\1$LIVE/privkey.pem;#" "$SITE"
if ! nginx -t; then
  mv "$SITE.bak" "$SITE"
  logger -t shikkhokplus "FAILED: nginx rejected the origin certificate"
  exit 1
fi
rm -f "$SITE.bak"
systemctl reload nginx
if [ "$${SHIKKHOKPLUS_CERT_NO_UPLOAD:-0}" != "1" ]; then
  umask 077
  tar -C /etc -czf /root/letsencrypt.tar.gz letsencrypt
  aws s3 cp /root/letsencrypt.tar.gz \
    "s3://${config_bucket}/tls/letsencrypt.tar.gz" \
    --sse AES256 --only-show-errors --region "${aws_region}"
  rm -f /root/letsencrypt.tar.gz
fi
logger -t shikkhokplus "origin certificate installed; nginx reloaded"
HOOK
chmod 0700 /usr/local/bin/shikkhokplus-cert-deployed

LIVE="/etc/letsencrypt/live/${origin_fqdn}"
if aws s3 cp "s3://${config_bucket}/tls/letsencrypt.tar.gz" \
     /root/letsencrypt.tar.gz --only-show-errors --region "${aws_region}" \
     >> /var/log/shikkhokplus-provision.log 2>&1; then
  tar -C /etc -xzf /root/letsencrypt.tar.gz
  rm -f /root/letsencrypt.tar.gz
fi

# 2592000 seconds is 30 days, certbot's own renewal window.
if [ -f "$LIVE/fullchain.pem" ] \
   && openssl x509 -checkend 2592000 -noout -in "$LIVE/fullchain.pem" >/dev/null; then
  echo "Origin certificate restored; valid for more than 30 days." \
    >> /var/log/shikkhokplus-provision.log
  SHIKKHOKPLUS_CERT_NO_UPLOAD=1 /usr/local/bin/shikkhokplus-cert-deployed \
    >> /var/log/shikkhokplus-provision.log 2>&1 \
    || echo "FAILED: restored certificate rejected by nginx" \
         >> /var/log/shikkhokplus-provision.log
elif certbot certonly --dns-route53 \
     -d "${origin_fqdn}" \
     --non-interactive --agree-tos --register-unsafely-without-email \
     --keep-until-expiring \
     --deploy-hook /usr/local/bin/shikkhokplus-cert-deployed \
     >> /var/log/shikkhokplus-provision.log 2>&1; then
  echo "Origin certificate issued or renewed for ${origin_fqdn}." \
    >> /var/log/shikkhokplus-provision.log
else
  echo "FAILED: certbot could not issue for ${origin_fqdn}. Serving snakeoil." \
    >> /var/log/shikkhokplus-provision.log
fi

# ---------------------------------------------------------------------
# Self-healing: bring the application up without waiting for a deploy
# ---------------------------------------------------------------------
#
# **This is what makes a replaced instance useful.** Without it the box
# boots healthy, nginx answers, and the API is simply absent until
# somebody notices and dispatches a deploy.
#
# The tag comes from SSM rather than from Terraform, because Terraform
# must not own which version runs -- an apply would otherwise change
# the deployed application.

IMAGE_TAG=$(aws ssm get-parameter \
  --name "/shikkhokplus/${name_prefix}/image-tag" \
  --query 'Parameter.Value' --output text \
  --region "${aws_region}" 2>/dev/null || echo "none")

if [ "$IMAGE_TAG" = "none" ] || [ -z "${ecr_repository_url}" ]; then
  # A first-ever boot, before any deploy has run. Correct and
  # expected: nginx serves, the API is absent, and the next deploy
  # fills it in. NOT an error.
  echo "provisioned (no image deployed yet)" \
    >> /var/log/shikkhokplus-provision.log
  ready_without_app
fi

# **The compose file comes from git, the secrets from SSM.** Neither
# survives instance replacement on the root volume, so a self-healing
# boot reconstructs both rather than waiting for a human to notice the
# API is missing.
cd /srv/shikkhokplus

RUNTIME_ENV=$(aws ssm get-parameter \
  --name "/shikkhokplus/${name_prefix}/runtime-env" \
  --with-decryption --query 'Parameter.Value' --output text \
  --region "${aws_region}" 2>/dev/null || echo "")

if [ -z "$RUNTIME_ENV" ] || [ "$RUNTIME_ENV" = "SHIKKHOKPLUS_ENVIRONMENT=unset" ]; then
  echo "provisioned (image $IMAGE_TAG known, no runtime env yet)" \
    >> /var/log/shikkhokplus-provision.log
  ready_without_app
fi

# **The restricted role, never the owner** [OPS-5]. The API and the
# scheduled jobs read SHIKKHOKPLUS_DATABASE_URL, which names
# shikkhok_app. The owner's URL is not written to this file at all:
# it is held in this shell only for the two one-shot commands below.
if ! DATABASE_URL=$(param database-url 2>/dev/null); then
  echo "FAILED: no database-url parameter. Is enable_rds true?" \
    > /var/log/shikkhokplus-provision.log
  exit 1
fi

umask 077
printf '%s\n' "$RUNTIME_ENV" > .env
echo "API_IMAGE=${ecr_repository_url}:$IMAGE_TAG" >> .env
echo "SHIKKHOKPLUS_DATABASE_URL=$DATABASE_URL" >> .env
chown ubuntu:ubuntu .env
unset DATABASE_URL

# Fetched rather than inlined: the script plus the compose file
# crossed EC2's 16KB user_data limit.
if ! aws s3 cp "s3://${config_bucket}/docker-compose.yml" \
     docker-compose.yml --region "${aws_region}" >/dev/null 2>&1; then
  echo "FAILED: could not fetch docker-compose.yml from S3" \
    > /var/log/shikkhokplus-provision.log
  exit 1
fi
chown ubuntu:ubuntu docker-compose.yml

sudo -u ubuntu docker compose pull

# **Migrations as a distinct, logged step, before anything serves.**
#
# team.md: "Alembic runs as a distinct, logged step before the new
# container serves traffic, never as a side effect of application
# start." A container that migrates on start migrates once per
# replica and gives the operator no place to stop between the backup
# and the schema change.
#
# `run --rm` rather than `exec`: there is no running container yet,
# and this must complete before one exists.
#
# **The `migrate` service, not `api`** [OPS-5]. It is the only service
# given the owner's URL, and it receives it from THIS shell's
# environment through `sudo --preserve-env` and compose interpolation:
# never on a command line (where `ps` shows it), never in a file on
# disk, never in the API container. Order is fixed: migrate, then set
# the restricted role's password, then start the API that logs in with
# it.
echo "Running migrations..." >> /var/log/shikkhokplus-provision.log
SHIKKHOKPLUS_MIGRATION_DATABASE_URL=$(param migration-database-url)
SHIKKHOKPLUS_APP_DB_PASSWORD=$(param app-db-password)
export SHIKKHOKPLUS_MIGRATION_DATABASE_URL SHIKKHOKPLUS_APP_DB_PASSWORD
migrate() {
  sudo -u ubuntu \
    --preserve-env=SHIKKHOKPLUS_MIGRATION_DATABASE_URL,SHIKKHOKPLUS_APP_DB_PASSWORD \
    docker compose --profile migrate run --rm migrate "$@" \
    >> /var/log/shikkhokplus-provision.log 2>&1
}
if ! migrate alembic upgrade head; then
  echo "FAILED: alembic upgrade head" >> /var/log/shikkhokplus-provision.log
  # **Exit non-zero and serve nothing.** An instance that starts the
  # API against a schema the migration could not apply is worse than
  # an instance that does not start: it answers requests wrongly.
  exit 1
fi
if ! migrate python -m app.db.commands set-app-role-password; then
  echo "FAILED: could not set the shikkhok_app password" \
    >> /var/log/shikkhokplus-provision.log
  exit 1
fi
unset SHIKKHOKPLUS_MIGRATION_DATABASE_URL SHIKKHOKPLUS_APP_DB_PASSWORD

sudo -u ubuntu docker compose up -d --remove-orphans

# **The daily fee-cycle generation, installed by Terraform and never by
# hand** [NFR25.9, infrastructure-specification § 3].
#
# The ASG replaces this instance on every deploy -- the rollout step
# refreshes it deliberately, so "a refresh exercises the same path a
# replacement takes after a failure". A cron entry added over SSM
# therefore survives until the next routine deploy and no longer, and
# because generation SELF-HEALS, nothing looks wrong when it stops:
# the system reports healthy right up to the moment somebody notices
# nobody has been billed since that deploy. Writing the entry here is
# what makes it survive the event it has to survive.
#
# Same shape as the Alembic step above: `run --rm` against the api
# service, so the job uses the deployed image and its configuration
# rather than a second copy of either.
#
# 02:00 UTC is 08:00 in Dhaka -- after any overnight deploy window and
# before a teacher opens the app to check the month's fees.
echo "Installing the generation cron entry..." \
  >> /var/log/shikkhokplus-provision.log
# **The log files exist, owned by ubuntu, BEFORE any job appends.**
# The jobs run as ubuntu and /var/log is root's: a `>>` into a file
# ubuntu cannot create fails the redirection, and bash then does not
# run the command at all. The job never starts and the error goes to
# cron's local mail, which nobody reads [OPS-1].
install -o ubuntu -g ubuntu -m 0640 /dev/null /var/log/shikkhokplus-fee-generation.log
install -o ubuntu -g ubuntu -m 0640 /dev/null /var/log/shikkhokplus-session-generation.log
cat > /etc/cron.d/shikkhokplus-fee-generation <<'CRON'
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# min hour dom mon dow user command
0 2 * * * ubuntu cd /srv/shikkhokplus && docker compose run --rm api python -m app.fees.commands generate >> /var/log/shikkhokplus-fee-generation.log 2>&1
CRON
chmod 0644 /etc/cron.d/shikkhokplus-fee-generation

# **The daily session generation** [BR1.1, observability-design § 4.1].
#
# Installed here for exactly the reason the fee entry is, and with more
# force: session generation ALSO self-heals, so a cron entry wiped by
# the next routine deploy produces no visible symptom until the morning
# a teacher opens the app and there is no class to mark attendance
# against.
#
# **01:00 UTC is 07:00 in Dhaka.** It must complete before the earliest
# plausible class and must not collide with the fee job at 02:00, which
# shares this instance and this database. The design constrains it only
# to those two properties; the specific hour is this build's choice.
#
# The job registers its heartbeat under its OWN name, and the freshness
# service above needs NO change to cover it: that check enumerates every
# registered job rather than checking the fee job by name
# [infrastructure-specification § 3.3, the human's option B], which is
# the property that keeps this file unedited as D5 and D6 add jobs.
echo "Installing the session-generation cron entry..." \
  >> /var/log/shikkhokplus-provision.log
cat > /etc/cron.d/shikkhokplus-session-generation <<'CRON'
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# min hour dom mon dow user command
0 1 * * * ubuntu cd /srv/shikkhokplus && docker compose run --rm api python -m app.teaching.commands generate >> /var/log/shikkhokplus-session-generation.log 2>&1
CRON
chmod 0644 /etc/cron.d/shikkhokplus-session-generation

# **The freshness check is NOT a second cron entry** [§ 1.4].
#
# A check sharing the job's trigger is circular: if the trigger is
# gone, neither the job nor its own self-check runs and the alert
# never fires. So the two are given different mechanisms -- cron for
# the job, a `Restart=always` service for the check -- and a crontab
# that is edited, corrupted or emptied leaves the check running to
# notice.
#
# **What this does NOT survive, stated plainly rather than implied.**
# Both are written by THIS script, so an instance replacement wipes
# and reinstalls both together: the check cannot detect its own
# absence any more than the job can. What it covers is every failure
# short of that -- a broken crontab, a cron daemon that died, a job
# erroring every night -- which is the larger share of them. The
# instance-replacement case is covered by this file being the thing
# Terraform applies, so a replacement RE-RUNS it rather than skipping
# it; that is exactly why the entry is here and not added over SSM.
#
# A systemd *timer* would have been the natural choice and is the
# wrong one: it is host-level scheduling like cron, so a reader would
# reasonably assume the two differ more than they do.
echo "Installing the freshness check..." \
  >> /var/log/shikkhokplus-provision.log
cat > /home/ubuntu/freshness-check.sh <<'CHECK'
#!/bin/bash
# Deliberately an infinite loop in a restart-always container rather
# than a host timer: it must survive exactly what cron does not.
while true; do
  sleep 3600
  cd /srv/shikkhokplus || continue
  docker compose run --rm api python -m app.fees.commands check-freshness \
    >> /var/log/shikkhokplus-fee-generation.log 2>&1
done
CHECK
chmod 0755 /home/ubuntu/freshness-check.sh
chown ubuntu:ubuntu /home/ubuntu/freshness-check.sh

cat > /etc/systemd/system/shikkhokplus-freshness.service <<'UNIT'
[Unit]
Description=Alert when fee generation has not succeeded recently
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=ubuntu
ExecStart=/home/ubuntu/freshness-check.sh
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now shikkhokplus-freshness.service \
  >> /var/log/shikkhokplus-provision.log 2>&1 || \
  echo "WARNING: freshness check did not start" \
    >> /var/log/shikkhokplus-provision.log

# **Assert the outcome, not the command.** `up -d` succeeds on a
# container that starts and immediately exits, so a boot reporting
# success here would hide exactly the failure this script exists to
# catch.
#
# **Ready means what CloudFront will see** [OPS-6]. The probe goes
# through nginx over TLS to the origin NAME, with certificate
# verification on, carrying the origin secret -- the exact hop
# CloudFront makes -- and requires the body to report a reachable
# database. A host on snakeoil, behind a broken nginx config, or with
# an API that cannot reach PostgreSQL is not ready, is never put in
# service, and during a deploy leaves the previous host serving.
for _ in $(seq 1 24); do
  if body=$(curl -fsS -m 5 \
       --resolve "${origin_fqdn}:443:127.0.0.1" \
       -H "X-Origin-Secret: $ORIGIN_SECRET" \
       "https://${origin_fqdn}/health" 2>/dev/null) \
     && [[ "$body" == *'"database":"ok"'* ]]; then
    echo "provisioned (running $IMAGE_TAG, migrated, healthy over TLS)" \
      >> /var/log/shikkhokplus-provision.log
    register_dns
    lifecycle CONTINUE
    exit 0
  fi
  sleep 5
done

echo "FAILED: $IMAGE_TAG did not answer /health through nginx in 120s" \
  >> /var/log/shikkhokplus-provision.log
sudo -u ubuntu docker compose logs --tail 50 \
  >> /var/log/shikkhokplus-provision.log 2>&1
exit 1
