# Copy to terraform.tfvars and fill in. The real file is gitignored.
# In CI these come from TF_VAR_* in deploy.yml instead.

# The PARENT domain whose Route53 hosted zone ALREADY EXISTS. Terraform
# looks it up and fails loudly if it does not, and never modifies it
# except for this environment's one NS delegation record.
apex_domain = "example.com"

# staging or production. Also chooses the zone label below.
environment = "staging"

# The zone label under the apex. Leave unset to take the per-environment
# default -- "shikkhokplus" for staging, "shikkhokplus-prod" for
# production -- so the two environments never claim the same zone,
# delegation or CloudFront alias [OPS-10]. Must contain "shikkhokplus".
# project_subdomain = "shikkhokplus-prod"

# api.<zone>
api_subdomain = "api"

# **No SSH key and no operator IP.** Access is SSM Session Manager:
#   aws ssm start-session --target $(terraform output -raw app_instance_id)

# A second host for rehearsing migrations. Off by default; turn it on
# before real children's records arrive (team.md requires one).
enable_staging_instance = false

# RDS. **Required**: the deploy replaces the app host on every release
# and its root volume is deleted with it, so a database on the host is
# lost on the next deploy. Production refuses false at plan time and
# the deploy workflow refuses to release without an RDS instance to
# snapshot [OPS-7].
enable_rds = true

# Where alarms and the budget alert are emailed [OPS-11]. AWS sends a
# confirmation mail first; nothing is delivered until it is clicked.
# alert_email = "you@example.com"
