# The API origin the production build talks to. Empty means same-origin
# (the web app served from the API's own host). Must be https.
VITE_API_BASE_URL=

# The public site's origin (bare https, no path), where published hub pages
# live: "View public page" links there, and it is added to the page's CSP
# style-src because the hub preview links its stylesheet there. Empty
# means no "View public page" link. deploy.yml passes the site-url SSM
# parameter.
VITE_SITE_URL=
