{
  "name": "shikkhokplus-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ShikkhokPlus web client: an installable PWA over the same /v1 API the Android app uses.",
  "scripts": {
    "dev": "vite",
    "dev:admin": "vite --config vite.admin.config.ts",
    "build": "tsc -b && vite build",
    "build:admin": "vite build --config vite.admin.config.ts",
    "preview": "vite preview",
    "preview:admin": "vite preview --config vite.admin.config.ts",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "gen": "npm run gen:api && npm run gen:strings",
    "gen:api": "openapi-typescript ../openapi.json -o src/api/schema.d.ts && prettier --write src/api/schema.d.ts",
    "gen:strings": "node scripts/sync-strings.mjs",
    "gen:icons": "node scripts/make-icons.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "check:bundles": "node scripts/check-bundles.mjs",
    "check": "npm run check:generated && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run build:admin && npm run check:bundles"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@types/node": "22.19.1",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "jsdom": "27.4.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.12",
    "workbox-window": "7.4.1"
  }
}
