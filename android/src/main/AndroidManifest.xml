<?xml version="1.0" encoding="utf-8"?>
<!--
  Deliberately minimal.

  The merged-manifest permission allowlist asserts an exact approved permission set plus the ABSENCE of
  com.google.android.gms.permission.AD_ID — the declaration a transitive ads
  or analytics SDK adds silently via manifest merger.

  A unit test asserts the declared set by parsing uses-permission
  elements rather than matching text — so this comment, which names AD_ID in order to forbid it, does not itself trip
  the check. An earlier version of that test matched the comment and
  failed on the warning while saying nothing about the thing.

  The permission set is an exact allowlist, asserted by a unit test on
  this file and by the release gate on the merged manifest. INTERNET is
  for the API; POST_NOTIFICATIONS is for the unread tray notification.
  Anything else WorkManager merges is listed, with its reason, in
  android/release-gates.gradle.kts and android/sdk-admissions.

  FOREGROUND_SERVICE is REMOVED from the merge. WorkManager declares it
  for expedited work, and this app schedules none: the unread check is
  plain periodic work. A permission granted for nothing is a line on the
  Families declaration that buys nothing, so the merger is told to drop
  it rather than the allowlist told to accept it.

  There is still no android:usesCleartextTraffic and none is wanted:
  the backend is https-only, ApiClient refuses a non-https base URL in
  code, and the one exemption is a loopback host for local development.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />

    <!--
      allowBackup is FALSE deliberately. Auto Backup would copy app data
      to the user's Google Drive, which for this product means
      children's-adjacent data leaving the controlled store under
      RC-1/RC-2/RC-3 with no disclosure covering it. Turning it off is
      cheaper and more honest than explaining it on the Data Safety form.
    -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShikkhokPlus"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
