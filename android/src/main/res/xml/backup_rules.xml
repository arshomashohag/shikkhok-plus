<?xml version="1.0" encoding="utf-8"?>
<!--
  The Android 11-and-lower half of data_extraction_rules.xml: every domain
  excluded [RC-1, RC-2, RC-3, C-46].

  Belt and braces. On those releases allowBackup="false" already turns
  off cloud backup, device-to-device transfer and adb backup, so this
  file changes nothing while that flag holds. It is here so that turning
  the flag on by mistake still copies nothing off the phone.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
