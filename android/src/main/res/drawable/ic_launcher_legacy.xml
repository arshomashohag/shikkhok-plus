<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon for API 24-25, which predate adaptive icons.

  **This exists because minSdk is 24 and `mipmap-anydpi-v26` does not
  cover it.** Without it those devices fall back to Android's default
  green robot, and this product's audience is exactly the budget phone
  most likely to still be on Nougat.

  Same mark, but the blue tile is drawn INTO the icon rather than
  supplied as a separate background layer, because a pre-26 launcher
  composites nothing: it takes one bitmap or drawable as-is. The 26dp
  corner radius imitates the squircle those launchers apply themselves
  on later versions.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The tile, rounded, since nothing will mask it for us. -->
