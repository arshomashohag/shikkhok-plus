{
  "components": {
    "schemas": {
      "BatchCreateRequest": {
        "additionalProperties": false,
        "description": "Create a batch [AC2.1.1, AC2.1.2].\n\n:ivar name: The teacher's name for the class\n:ivar subjects: One or more subjects taught\n:ivar teacher_display_name: What students see the teacher called\n:ivar default_fee: The fee an enrollment inherits when it sets none\n:ivar fee_due_day: Day of month 1-31; 29-31 clamp at generation\n:ivar collection_number: Where payments are sent\n:ivar collection_channel: Which service that number belongs to",
        "properties": {
          "collection_channel": {
            "anyOf": [
              {
                "maxLength": 32,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Collection Channel"
          },
          "collection_number": {
            "anyOf": [
              {
                "maxLength": 32,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Collection Number"
          },
          "default_fee": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Money"
              },
              {
                "type": "null"
              }
            ]
          },
          "fee_due_day": {
            "anyOf": [
              {
                "maximum": 31.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fee Due Day"
          },
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "subjects": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Subjects",
            "type": "array"
          },
          "teacher_display_name": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Teacher Display Name"
          }
        },
        "required": [
          "name",
          "subjects"
        ],
        "title": "BatchCreateRequest",
        "type": "object"
      },
      "BatchResponse": {
        "description": "A batch as its owner sees it.\n\n:ivar id: The batch\n:ivar name: The teacher's name for the class\n:ivar subjects: The subjects taught\n:ivar teacher_display_name: What students see the teacher called\n:ivar default_fee: The inherited fee\n:ivar fee_due_day: Day of month 1-31\n:ivar collection_number: Where payments are sent\n:ivar collection_channel: Which service that number belongs to\n:ivar marksheet_visible: U6's toggle\n:ivar active: False means read-only history\n:ivar enrollment_count: How many seats, computed server-side",
        "properties": {
          "active": {
            "title": "Active",
            "type": "boolean"
          },
          "collection_channel": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Collection Channel"
          },
          "collection_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Collection Number"
          },
          "default_fee": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Money"
              },
              {
                "type": "null"
              }
            ]
          },
          "enrollment_count": {
            "title": "Enrollment Count",
            "type": "integer"
          },
          "fee_due_day": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fee Due Day"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "marksheet_visible": {
            "title": "Marksheet Visible",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "subjects": {
            "items": {
              "type": "string"
            },
            "title": "Subjects",
            "type": "array"
          },
          "teacher_display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Teacher Display Name"
          }
        },
        "required": [
          "active",
          "collection_channel",
          "collection_number",
          "default_fee",
          "enrollment_count",
          "fee_due_day",
          "id",
          "marksheet_visible",
          "name",
          "subjects",
          "teacher_display_name"
        ],
        "title": "BatchResponse",
        "type": "object"
      },
      "EnrollmentCreateRequest": {
        "additionalProperties": false,
        "description": "Add a student to a batch [AC2.2.2, AC2.2.5].\n\n``fee_amount`` is nullable and null means **inherit** the batch\ndefault. Zero is a real fee of zero, which is a waiver -- a\nnon-nullable column defaulting to zero would make the two\nindistinguishable and silently charge nothing.\n\n:ivar display_name: The teacher-typed name for this seat\n:ivar student_phone: The student's number, typed by the teacher\n:ivar guardian_phone: The guardian's number, if one is recorded\n:ivar fee_amount: This seat's fee, or null to inherit\n:ivar joined_on: When the student joined",
        "properties": {
          "display_name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "fee_amount": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Money"
              },
              {
                "type": "null"
              }
            ]
          },
          "guardian_phone": {
            "anyOf": [
              {
                "maxLength": 20,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Guardian Phone"
          },
          "joined_on": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Joined On"
          },
          "student_phone": {
            "anyOf": [
              {
                "maxLength": 20,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Student Phone"
          }
        },
        "required": [
          "display_name"
        ],
        "title": "EnrollmentCreateRequest",
        "type": "object"
      },
      "ErrorBody": {
        "additionalProperties": false,
        "description": "The error payload.\n\n:ivar code: A stable machine value the client switches on\n:ivar retryable: Derived from the exception class at the handler\n:ivar message_key: Names a client string resource\n:ivar details: Typed per code; rendered, never interpreted",
        "properties": {
          "code": {
            "description": "Stable machine value; never message text.",
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Typed per code. Rendered, never interpreted.",
            "title": "Details"
          },
          "message_key": {
            "description": "Names a client string resource. No English is emitted.",
            "title": "Message Key",
            "type": "string"
          },
          "retryable": {
            "description": "Server-provided. The client is told, never infers.",
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message_key",
          "retryable"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorEnvelope": {
        "additionalProperties": false,
        "description": "The shape of every error response in the system.\n\n:ivar error: The error payload",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "GuardianChildResponse": {
        "description": "One reachable child as a guardian sees it.\n\nCarries ``batch_name`` and ``teacher_display_name`` because\nattribution is required even in the single-child case [AC2.8.5] --\nthat is where it is most needed, since the selection list is where\nit would otherwise have been shown.\n\n:ivar enrollment_id: The seat, which BR5.1 keys the route on\n:ivar display_name: The teacher-typed name for the child\n:ivar batch_name: Which class\n:ivar teacher_display_name: Which teacher recorded this",
        "properties": {
          "batch_name": {
            "title": "Batch Name",
            "type": "string"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "enrollment_id": {
            "format": "uuid",
            "title": "Enrollment Id",
            "type": "string"
          },
          "teacher_display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Teacher Display Name"
          }
        },
        "required": [
          "batch_name",
          "display_name",
          "enrollment_id",
          "teacher_display_name"
        ],
        "title": "GuardianChildResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "description": "What the smoke set reads.\n\n:ivar status: ``ok`` when the process is serving\n:ivar database: ``ok`` or ``fail``\n:ivar migration_revision: The applied Alembic revision, or None",
        "properties": {
          "database": {
            "enum": [
              "fail",
              "ok"
            ],
            "title": "Database",
            "type": "string"
          },
          "migration_revision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Migration Revision"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "database",
          "migration_revision",
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "InactiveFromRequest": {
        "additionalProperties": false,
        "description": "Mark a seat inactive from a date, or clear it [AC2.4.1].\n\n:ivar inactive_from: The date, or null to reactivate the seat",
        "properties": {
          "inactive_from": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Inactive From"
          }
        },
        "title": "InactiveFromRequest",
        "type": "object"
      },
      "IssueRequest": {
        "additionalProperties": false,
        "description": "Ask for a code to be sent to a number.\n\nThe number is **typed by the user** and never read from the SIM\n[AC1.1.6]: there is no device-side source for this field.\n\n:ivar phone: The destination number in international form",
        "properties": {
          "phone": {
            "maxLength": 20,
            "minLength": 8,
            "title": "Phone",
            "type": "string"
          }
        },
        "required": [
          "phone"
        ],
        "title": "IssueRequest",
        "type": "object"
      },
      "IssueResponse": {
        "additionalProperties": false,
        "description": "The response to an issue request, for **any** number.\n\nOne field, and it is a fixed string. Anything varying between the\nknown and unknown branches -- a count, a timestamp, a message -- is\nthe existence oracle re-entering through the schema.\n\n:ivar status: Always ``requested``",
        "properties": {
          "status": {
            "default": "requested",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "IssueResponse",
        "type": "object"
      },
      "Money": {
        "description": "A BDT amount in canonical form: exactly two decimal places, no thousands separator, no currency symbol, no sign. Always a JSON string, never a JSON number.",
        "pattern": "^[0-9]+\\.[0-9]{2}$",
        "title": "Money",
        "type": "string"
      },
      "RefreshRequest": {
        "additionalProperties": false,
        "description": "Present a refresh token for rotation.\n\n:ivar refresh_token: The opaque token previously issued",
        "properties": {
          "refresh_token": {
            "maxLength": 512,
            "minLength": 16,
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "title": "RefreshRequest",
        "type": "object"
      },
      "RosterRowResponse": {
        "description": "One seat as a teacher sees it.\n\n``status`` is a **server-computed decision**, not an input to one\n[TC-9]: the client switches on this enum and never compares a date\nor an amount of its own.\n\n:ivar enrollment_id: The teacher-facing key for this seat\n:ivar display_name: The teacher-typed name\n:ivar guardian_phone: The teacher-typed guardian contact\n:ivar fee_amount: This seat's fee, or null when it inherits\n:ivar status: ``dormant``, ``active`` or ``inactive``\n:ivar inactive_from: The recorded date, if any",
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "enrollment_id": {
            "format": "uuid",
            "title": "Enrollment Id",
            "type": "string"
          },
          "fee_amount": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Money"
              },
              {
                "type": "null"
              }
            ]
          },
          "guardian_phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Guardian Phone"
          },
          "inactive_from": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Inactive From"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "display_name",
          "enrollment_id",
          "fee_amount",
          "guardian_phone",
          "inactive_from",
          "status"
        ],
        "title": "RosterRowResponse",
        "type": "object"
      },
      "TokenResponse": {
        "additionalProperties": false,
        "description": "A freshly issued token pair.\n\n**No lens and no role here either.** The response says nothing about\nwhat the account may do; that is resolved per request from the data\n[BR1.1].\n\n:ivar access_token: The short-lived bearer token\n:ivar refresh_token: The long-lived rotation token\n:ivar expires_in: Access-token lifetime in seconds",
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "expires_in",
          "refresh_token"
        ],
        "title": "TokenResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VerifyRequest": {
        "additionalProperties": false,
        "description": "Present a code for verification.\n\n:ivar phone: The number the code was issued for\n:ivar code: The six-digit code",
        "properties": {
          "code": {
            "maxLength": 10,
            "minLength": 4,
            "title": "Code",
            "type": "string"
          },
          "phone": {
            "maxLength": 20,
            "minLength": 8,
            "title": "Phone",
            "type": "string"
          }
        },
        "required": [
          "code",
          "phone"
        ],
        "title": "VerifyRequest",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Private tuition management. Every money value crosses this boundary as a JSON string; every lens-scoped response names the lens that produced it.",
    "title": "ShikhokPlus API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Report liveness, database connectivity and schema revision.\n\n:param session: The request-scoped session\n:return: The health report",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/auth/otp": {
      "post": {
        "description": "Issue a code, returning the same response for any number.\n\n:param body: The request body\n:param request: The incoming request\n:param session: The request-scoped session\n:param gateway: The configured SMS gateway\n:return: The contentless acknowledgement",
        "operationId": "issue_code_v1_auth_otp_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IssueRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssueResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Issue Code",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "description": "Rotate a refresh token, invalidating the family on reuse.\n\nAuthenticated but **lens-exempt**: the caller has a token and no\nlens has been resolved yet, which is exactly why\n``LENS_EXEMPT_AUTHENTICATED`` exists as a separate set.\n\n:param body: The request body\n:param request: The incoming request\n:param session: The request-scoped session\n:param authorization: The bearer header, unused but required present\n:return: The replacement pair",
        "operationId": "refresh_tokens_v1_auth_refresh_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Refresh Tokens",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/verify": {
      "post": {
        "description": "Verify a code and issue a token pair.\n\n:param body: The request body\n:param request: The incoming request\n:param session: The request-scoped session\n:return: The new token pair",
        "operationId": "verify_code_v1_auth_verify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Verify Code",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/batches": {
      "get": {
        "description": "List this teacher's batches [AC2.6.1].\n\n:param lens: The teacher lens carrying the owner id\n:param session: The request-scoped session\n:return: One entry per batch, newest first",
        "operationId": "list_batches_v1_batches_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/BatchResponse"
                  },
                  "title": "Response List Batches V1 Batches Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Batches",
        "tags": [
          "batches"
        ]
      },
      "post": {
        "description": "Create a batch [AC2.1.1].\n\n:param body: The batch to create\n:param lens: The teacher lens carrying the owner id\n:param session: The request-scoped session\n:return: The created batch",
        "operationId": "create_batch_v1_batches_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Batch",
        "tags": [
          "batches"
        ]
      }
    },
    "/v1/batches/{batch_id}/enrollments": {
      "post": {
        "description": "Add a student to a batch [AC2.2.2].\n\n:param batch_id: The batch to add to\n:param body: The seat to create\n:param lens: The teacher lens carrying the owner id\n:param session: The request-scoped session\n:return: The created seat",
        "operationId": "add_enrollment_v1_batches__batch_id__enrollments_post",
        "parameters": [
          {
            "in": "path",
            "name": "batch_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Batch Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
