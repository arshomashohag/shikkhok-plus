# Copy to .env and fill in. The real .env is gitignored.
#
# Generate each secret with: openssl rand -base64 32
# Record them in a password manager AS YOU GENERATE THEM. None of the
# three is recoverable: losing the JWT key force-logs-out every holder
# of a 30-day refresh token, and losing the OTP HMAC key invalidates
# every outstanding code.

# "staging" or "production". Only "production" triggers the startup
# check that refuses a process missing any value below.
SHIKKHOKPLUS_ENVIRONMENT=staging

POSTGRES_PASSWORD=
SHIKKHOKPLUS_OTP_HMAC_KEY=

# Format is <kid>:<key>. Multiple keys are comma-separated, which is
# what lets a signing key rotate without force-logging-out every
# holder of a refresh token.
SHIKKHOKPLUS_JWT_KEYS=k1:
SHIKKHOKPLUS_JWT_ACTIVE_KID=k1

# Exactly 11 characters, from the Play release. The SMS Retriever API
# needs it to match or autofill silently does not work.
SHIKKHOKPLUS_SMS_APP_HASH=

# The global daily ceiling. Per-SMS billing makes abuse a direct attack
# on the project's wallet, so this is a cost control, not a nicety.
SHIKKHOKPLUS_GLOBAL_DAILY_SMS=50

# FAIL-SAFE: only the literal "bulksmsbd" selects the real,
# money-spending adapter. Anything else -- including empty -- selects
# the null gateway, which records the intended send and makes no
# network call.
SHIKKHOKPLUS_SMS_ADAPTER=bulksmsbd
SHIKKHOKPLUS_SMS_API_KEY=
SHIKKHOKPLUS_SMS_SENDER_ID=

# HTTPS, and the adapter REFUSES anything else in code. Probed live:
# bulksmsbd.net serves https and returns the same response_code
# behaviour -- and plain http does NOT redirect to it, so a
# misconfigured http:// URL would ship the phone number and the OTP in
# cleartext while succeeding silently. Nothing would fail, warn or log.
SHIKKHOKPLUS_SMS_BASE_URL=https://bulksmsbd.net/api/smsapi

# Staging/development ONLY: exposes the most recent OTP for a number to
# an unauthenticated caller. Set to 0 once real SMS works -- codes
# arrive on the phone, so the route has no remaining purpose. A
# PRODUCTION process with this set refuses to start.
SHIKKHOKPLUS_STAGING_OUTBOX=0

# Browser origins allowed to call the API (CORS), comma-separated, exact
# https origins only -- e.g. https://app.shikkhokplus.com. Needed only when
# the web client (web/) is served from a different origin than the API.
# Empty means no CORS headers at all. See app/web_origins.py.
SHIKKHOKPLUS_WEB_ORIGINS=

# Phone numbers and email addresses allowed into the platform
# administration surface (/v1/admin, and /ui/admin in the web client),
# comma-separated, mixed freely: 01711111111, +8801711111111,
# you@example.com. An entry with an @ is an email address; the admin is
# sent their sign-in code by email. Empty means nobody. An admin
# sees teachers and centres by name, the apps people use, aggregate
# counts and help-centre questions -- never a student's or guardian's
# name or number [TC-14, D-6]. See app/authz/admin.py.
SHIKKHOKPLUS_PLATFORM_ADMIN_PHONES=

# The platform admin surface's network locks (app/authz/admin.py). In a
# deployment the admin API is served only at admin.<zone>, whose CloudFront
# distribution checks the viewer's IP and adds an X-Admin-Edge header; the
# API refuses every /v1/admin route unless that header carries this exact
# value AND the client address (X-Client-Address, which nginx sets from
# CloudFront) is inside one of the networks below. Either one empty means
# NOBODY gets in -- fail closed.
#
# Deployed: the secret is generated by Terraform (infra/modules/admin, SSM
# /shikkhokplus/<prefix>/admin-edge-secret) and copied into the runtime env
# by deploy.yml; the networks come from the SHIKKHOKPLUS_ADMIN_ALLOWED_CIDRS
# repository secret, the same list the edge function enforces. Locally,
# with no CloudFront in front, send the header yourself:
#   curl -H "X-Admin-Edge: $SHIKKHOKPLUS_ADMIN_EDGE_SECRET" ...
# and make up any long alphanumeric value here.
SHIKKHOKPLUS_ADMIN_EDGE_SECRET=
# Comma-separated CIDRs. Loopback for local development; a deployment uses
# IPv4 /32s, because the admin distribution serves IPv4 only.
SHIKKHOKPLUS_ADMIN_ALLOWED_CIDRS=127.0.0.0/8,::1/128

# The keyring that encrypts administrators' authenticator (TOTP) secrets,
# AES-256-GCM (app/auth/mfa_crypto.py): comma-separated kid:base64 pairs,
# each key 32 random bytes. Generate one with
#   python3 -c "import os,base64;print('k1:'+base64.b64encode(os.urandom(32)).decode())"
# Rotate by ADDING k2 beside k1 and making it active; removing a key every
# enrolled administrator still depends on locks them out of their factor.
# With administrators named above and no keyring, nobody can finish signing
# in, and a production process refuses to start.
SHIKKHOKPLUS_MFA_KEYS=
SHIKKHOKPLUS_MFA_ACTIVE_KID=k1

# Emailed codes (sign-up and recovery for email accounts). `null` mails
# nobody; read a code locally from GET /staging/last-otp?email=... with
# SHIKKHOKPLUS_STAGING_OUTBOX=1. A deployment uses `ses` with the SMTP
# credentials infra/modules/email publishes to SSM; a production process
# without them refuses to start.
SHIKKHOKPLUS_EMAIL_ADAPTER=null
SHIKKHOKPLUS_SES_SMTP_HOST=
SHIKKHOKPLUS_SES_SMTP_PORT=587
SHIKKHOKPLUS_SES_SMTP_USERNAME=
SHIKKHOKPLUS_SES_SMTP_PASSWORD=
SHIKKHOKPLUS_EMAIL_FROM=
SHIKKHOKPLUS_SES_CONFIGURATION_SET=
SHIKKHOKPLUS_GLOBAL_DAILY_EMAIL=1000
